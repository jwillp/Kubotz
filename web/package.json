    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "phaser": "3.90.0",
    "planck": "^1.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
